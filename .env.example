# ============================================
# Cleo.ai — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# Variables marked [REQUIRED] must be set for the app to start.
# Variables marked [OPTIONAL] enable additional features; the app
# degrades gracefully when they are absent.
# ============================================

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/cleo    # [REQUIRED] PostgreSQL connection string

# --- Authentication ---
JWT_SECRET=                            # [REQUIRED] Min 32 characters. Used for signing JWTs and CSRF tokens.

# --- Admin Seed ---
ADMIN_EMAIL=admin@cleo.ai             # [OPTIONAL] Email for the auto-seeded admin account. Admin is only created if BOTH are set.
ADMIN_PASSWORD=                        # [OPTIONAL] Password for the admin account. No default — must be explicitly set to seed an admin.

# --- AI / LLM ---
OPENAI_API_KEY=                        # [OPTIONAL] Enables AI chat. Without it, chat returns friendly fallback responses.
# ANTHROPIC_API_KEY=                   # [OPTIONAL] Alternative AI provider
# AI_PROVIDER=openai                   # [OPTIONAL] "openai" (default) or "anthropic"

# --- Twilio (Voice & SMS) ---
TWILIO_ACCOUNT_SID=                    # [OPTIONAL] Enables outbound calls and SMS
TWILIO_AUTH_TOKEN=                     # [OPTIONAL]
TWILIO_PHONE_NUMBER=                   # [OPTIONAL] Twilio phone number for outbound calls/SMS
# TWILIO_WHATSAPP_NUMBER=             # [OPTIONAL] WhatsApp-enabled Twilio number

# --- Email (SMTP) ---
SMTP_HOST=                             # [OPTIONAL] Enables transactional email. Without it, emails are logged to console.
SMTP_PORT=587                          # [OPTIONAL] Default: 587
SMTP_USER=                             # [OPTIONAL]
SMTP_PASS=                             # [OPTIONAL]
FROM_EMAIL=hello@cleo.ai               # [OPTIONAL] Sender address (default: hello@cleo.ai)

# --- Google OAuth ---
GOOGLE_CLIENT_ID=                      # [OPTIONAL] Enables "Sign in with Google". Without it, the Google login button is hidden.
GOOGLE_CLIENT_SECRET=                  # [OPTIONAL]

# --- Error Tracking ---
SENTRY_DSN=                            # [OPTIONAL] Enables Sentry error tracking. Without it, Sentry is not initialized.

# --- Analytics ---
POSTHOG_KEY=                           # [OPTIONAL] Enables PostHog analytics. Without it, PostHog is not initialized.

