generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector(schema: "public")]
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  phone                   String?                  @unique
  passwordHash            String
  role                    Role                     @default(USER)
  isActive                Boolean                  @default(true)
  emailVerified           Boolean                  @default(false)
  phoneVerified           Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  utmCampaign             String?
  utmMedium               String?
  utmSource               String?
  onboardingComplete      Boolean                  @default(false)
  name                    String?
  zoomAccessToken         String?
  zoomRefreshToken        String?
  zoomUserId              String?
  whatsappOptedIn         Boolean                  @default(false)
  whatsappPhone           String?
  mfaEnabled              Boolean                  @default(false)
  tier                    UserTier                 @default(FREE)
  totpSecret              String?
  clerkId                 String?                  @unique
  googleId                String?                  @unique
  linkedinId              String?                  @unique
  activities              Activity[]
  adminAuditLogs          AdminAuditLog[]          @relation("AuditActor")
  adminAuditTargets       AdminAuditLog[]          @relation("AuditTarget")
  calls                   Call[]
  communicationPreference CommunicationPreference?
  conversations           Conversation[]
  scoutedDeals            DealTracking[]           @relation("DealPartnerDeals")
  foundedDeals            DealTracking[]           @relation("FounderDeals")
  receivedDirectMessages  DirectMessage[]          @relation("DirectMessageRecipient")
  sentDirectMessages      DirectMessage[]          @relation("DirectMessageSender")
  eventParticipations     EventParticipant[]
  organizedEvents         Event[]
  googleCalendarToken     GoogleCalendarToken?
  introductionsAsA        IntroductionRecord[]     @relation("IntroUserA")
  introductionsAsB        IntroductionRecord[]     @relation("IntroUserB")
  inviteCodesCreated      InviteCode[]             @relation("InviteCodeCreator")
  inviteCodeUsed          InviteCode?              @relation("InviteCodeUser")
  matchFeedbacks          MatchFeedback[]
  sentMatches             Match[]                  @relation("MatchUserA")
  receivedMatches         Match[]                  @relation("MatchUserB")
  organizedMeetings       Meeting[]                @relation("MeetingOrganizer")
  participantMeetings     Meeting[]                @relation("MeetingParticipant")
  messageRecords          MessageRecord[]
  notifications           Notification[]
  matchesUsed             Int                      @default(0)
  referralCode            String?                  @unique
  referredBy              String?
  bonusMatches            Int                      @default(0)
  referralsMade           Referral[]               @relation("ReferralsMade")
  referralReceived        Referral?                @relation("ReferralReceived")
  profile                 Profile?
  secretaryThreads        SecretaryMessage[]
  embeddings              UserEmbedding[]
  dripEmails              DripEmail[]
  subscription            Subscription?

  @@index([email])
  @@index([phone])
  @@map("users")
}

model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  refereeId     String   @unique
  rewardGranted Boolean  @default(false)
  createdAt     DateTime @default(now())
  referrer      User     @relation("ReferralsMade", fields: [referrerId], references: [id])
  referee       User     @relation("ReferralReceived", fields: [refereeId], references: [id])

  @@index([referrerId])
  @@index([refereeId])
  @@map("referrals")
}

model Profile {
  id                  String                 @id @default(cuid())
  userId              String                 @unique
  persona             PersonaType?
  headline            String?
  bio                 String?
  companyName         String?
  companyStage        CompanyStage?
  currentRole         String?
  location            String?
  linkedinUrl         String?
  websiteUrl          String?
  yearsExperience     Int?
  industries          String[]               @default([])
  skills              String[]               @default([])
  interests           String[]               @default([])
  lookingFor          String[]               @default([])
  extraData           Json?
  completenessScore   Float                  @default(0)
  isComplete          Boolean                @default(false)
  matchLastCheckedAt  DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  accreditedInvestor  Boolean?
  amountRaisedToDate  String?
  businessDescription String?
  channelSource       String?
  channelType         String?
  cityBased           String?
  exampleInvestment   String?
  founderAccessPitch  String?
  fundName            String?
  fundSize            String?
  industryFocus       String[]               @default([])
  investmentAmount    String?
  investmentRange     String?
  investmentThesis    String?
  investorType        String?
  keyTractionPoints   String?
  outreachMethod      String?
  phoneNumber         String?
  priority            FounderPriority?
  raiseAmount         String?
  roundCloseDate      String?
  targetRole          TalentTargetRole?
  trackedCompanies    String?
  profileEmbedding    Unsupported("vector")?
  linkedinVerified    Boolean                @default(false)
  verificationScore   Float                  @default(0)
  avatarUrl           String?
  activeUsers         String?
  burnRate            String?
  checkSizeRange      String?
  dealsPerYear        Int?
  equityExpectation   String?
  functionalArea      String?
  growthRate          String?
  introPreference     IntroPreference?
  leadsRounds         Boolean?
  maxIntrosPerWeek    Int?
  monthlyRevenue      String?
  openToMeeting       Boolean                @default(true)
  portfolioCompanies  String[]               @default([])
  preferredStage      CompanyStage?
  preferredStageRange String?
  sectorFocus         String[]               @default([])
  workStyle           WorkStyle?
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([persona])
  @@index([companyStage])
  @@index([location])
  @@index([completenessScore])
  @@index([isComplete, matchLastCheckedAt])
  @@map("profiles")
}

model Conversation {
  id          String             @id @default(cuid())
  userId      String
  flowId      String
  status      ConversationStatus @default(ACTIVE)
  currentNode String?
  context     Json?
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([userId])
  @@index([status])
  @@map("conversations")
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  sender         MessageSender
  content        String
  nodeId         String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

model Match {
  id               String              @id @default(cuid())
  userAId          String
  userBId          String
  status           MatchStatus         @default(PROPOSED)
  score            Float
  scoreBreakdown   Json?
  userAResponse    MatchResponse?
  userBResponse    MatchResponse?
  userARespondedAt DateTime?
  userBRespondedAt DateTime?
  reason           String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  expiresAt        DateTime?
  eventId          String?
  userAViewedAt    DateTime?
  userBViewedAt    DateTime?
  introduction     IntroductionRecord?
  feedbacks        MatchFeedback[]
  event            Event?              @relation(fields: [eventId], references: [id])
  userA            User                @relation("MatchUserA", fields: [userAId], references: [id])
  userB            User                @relation("MatchUserB", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@index([status])
  @@index([score])
  @@index([eventId])
  @@map("matches")
}

model MatchFeedback {
  id        String   @id @default(cuid())
  matchId   String
  userId    String
  rating    Int
  feedback  String?
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
  @@map("match_feedbacks")
}

model IntroductionRecord {
  id            String             @id @default(cuid())
  matchId       String             @unique
  userAId       String
  userBId       String
  status        IntroductionStatus @default(SENT)
  talkingPoints String[]           @default([])
  scheduledAt   DateTime?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  followUpAt    DateTime?
  introText     String?
  outcome       String?
  outcomeNotes  String?
  sentAt        DateTime?
  sentVia       String?
  match         Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userA         User               @relation("IntroUserA", fields: [userAId], references: [id])
  userB         User               @relation("IntroUserB", fields: [userBId], references: [id])

  @@index([userAId])
  @@index([userBId])
  @@index([status])
  @@map("introduction_records")
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("activities")
}

model Call {
  id            String        @id @default(cuid())
  userId        String
  twilioCallSid String?       @unique
  status        CallStatus    @default(SCHEDULED)
  direction     CallDirection @default(OUTBOUND)
  phoneNumber   String
  duration      Int?
  transcript    Json?
  extractedData Json?
  scheduledAt   DateTime?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([twilioCallSid])
  @@map("calls")
}

model UserEmbedding {
  id        String                @id @default(cuid())
  userId    String
  vector    Unsupported("vector")
  source    EmbeddingSource
  content   String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_embeddings")
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  event     NotificationEvent
  title     String
  body      String
  metadata  Json?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([event])
  @@index([sentAt])
  @@map("notifications")
}

model MessageRecord {
  id             String         @id @default(cuid())
  userId         String
  recipientPhone String
  channel        MessageChannel
  content        String
  status         MessageStatus  @default(QUEUED)
  messageSid     String?
  errorMessage   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  provider       String?
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
  @@map("message_records")
}

model DealTracking {
  id              String        @id @default(cuid())
  dealPartnerId   String
  founderId       String
  status          DealStatus    @default(OPEN)
  industry        String?
  stage           CompanyStage?
  notes           String?
  introSent       Boolean       @default(false)
  introSentAt     DateTime?
  responseStatus  DealResponse?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  carryPercentage Float?
  closeDate       DateTime?
  dealValue       Float?
  introDate       DateTime?
  dealPartner     User          @relation("DealPartnerDeals", fields: [dealPartnerId], references: [id], onDelete: Cascade)
  founder         User          @relation("FounderDeals", fields: [founderId], references: [id], onDelete: Cascade)

  @@unique([dealPartnerId, founderId])
  @@index([dealPartnerId])
  @@index([founderId])
  @@index([status])
  @@map("deal_tracking")
}

model Event {
  id           String             @id @default(cuid())
  name         String
  description  String?
  date         DateTime
  endDate      DateTime?
  location     String?
  isVirtual    Boolean            @default(false)
  maxCapacity  Int?
  organizerId  String
  status       EventStatus        @default(UPCOMING)
  metadata     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  participants EventParticipant[]
  organizer    User               @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  matches      Match[]

  @@index([organizerId])
  @@index([date])
  @@index([status])
  @@map("events")
}

model EventParticipant {
  id               String                 @id @default(cuid())
  eventId          String
  userId           String
  status           EventParticipantStatus @default(REGISTERED)
  checkedIn        Boolean                @default(false)
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  eventCode        String?
  eventName        String?
  pitchTopic       String?
  preferredMentors String[]               @default([])
  registeredAt     DateTime               @default(now())
  event            Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_participants")
}

model CommunicationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  emailEnabled         Boolean  @default(true)
  smsEnabled           Boolean  @default(false)
  whatsappEnabled      Boolean  @default(false)
  inAppEnabled         Boolean  @default(true)
  matchNotify          Boolean  @default(true)
  introNotify          Boolean  @default(true)
  weeklyDigest         Boolean  @default(true)
  marketingEmails      Boolean  @default(false)
  quietHoursStart      String?
  quietHoursEnd        String?
  timezone             String?  @default("Asia/Kolkata")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  whatsappIntroNotify  Boolean  @default(true)
  whatsappMatchNotify  Boolean  @default(true)
  whatsappWeeklyDigest Boolean  @default(true)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("communication_preferences")
}

model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  createdById String
  usedById    String?   @unique
  usedAt      DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  createdBy   User      @relation("InviteCodeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy      User?     @relation("InviteCodeUser", fields: [usedById], references: [id])

  @@index([code])
  @@index([createdById])
  @@map("invite_codes")
}

model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  matchId     String?
  content     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  recipient   User      @relation("DirectMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User      @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([matchId])
  @@index([createdAt])
  @@map("direct_messages")
}

model Meeting {
  id            String        @id @default(cuid())
  organizerId   String
  participantId String
  matchId       String?
  title         String
  description   String?
  proposedTimes DateTime[]
  confirmedTime DateTime?
  duration      Int           @default(30)
  location      String?
  meetingUrl    String?
  status        MeetingStatus @default(PROPOSED)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  zoomMeetingId String?
  organizer     User          @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  participant   User          @relation("MeetingParticipant", fields: [participantId], references: [id], onDelete: Cascade)

  @@index([organizerId])
  @@index([participantId])
  @@index([status])
  @@map("meetings")
}

model SecretaryMessage {
  id        String        @id @default(cuid())
  userId    String
  role      MessageSender
  content   String
  metadata  Json?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("secretary_messages")
}

model GoogleCalendarToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_calendar_tokens")
}

model OAuthState {
  id        String   @id @default(cuid())
  state     String   @unique
  userId    String
  provider  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([state])
  @@index([expiresAt])
  @@map("oauth_states")
}

model AgentRunLog {
  id               String   @id @default(cuid())
  agentName        String
  success          Boolean
  durationMs       Int
  recordsProcessed Int      @default(0)
  errorMessage     String?
  metadata         String?
  createdAt        DateTime @default(now())

  @@index([agentName])
  @@index([createdAt])
  @@index([agentName, createdAt])
  @@map("agent_run_logs")
}

model SecurityLog {
  id        String           @id @default(cuid())
  timestamp DateTime         @default(now())
  userId    String?
  action    SecurityAction
  result    SecurityResult
  severity  SecuritySeverity @default(INFO)
  ipAddress String?
  userAgent String?
  metadata  Json?

  @@index([timestamp])
  @@index([userId])
  @@index([action])
  @@index([severity])
  @@index([result])
  @@map("security_logs")
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  actorId   String
  action    String
  targetId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  actor     User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  target    User?    @relation("AuditTarget", fields: [targetId], references: [id])

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([timestamp])
  @@map("admin_audit_logs")
}

model AIAuditLog {
  id                      String   @id @default(cuid())
  userId                  String
  endpoint                String
  provider                String   @default("openai")
  model                   String   @default("gpt-4o-mini")
  inputLength             Int      @default(0)
  outputLength            Int      @default(0)
  promptTokens            Int?
  completionTokens        Int?
  totalTokens             Int?
  latencyMs               Int      @default(0)
  promptInjectionDetected Boolean  @default(false)
  piiRedacted             Boolean  @default(false)
  redactionDetails        String[] @default([])
  outputTruncated         Boolean  @default(false)
  agentId                 String?
  userTier                String   @default("FREE")
  success                 Boolean  @default(true)
  errorMessage            String?
  inputContent            String?
  outputContent           String?
  createdAt               DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([provider, model])
  @@map("ai_audit_logs")
}

model AIUsageDaily {
  id               String   @id @default(cuid())
  date             DateTime
  provider         String
  model            String
  requestCount     Int      @default(0)
  totalTokens      Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  errorCount       Int      @default(0)
  alertSent        Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([date, provider, model], name: "date_provider_model")
  @@index([date])
  @@map("ai_usage_daily")
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  persona   String?
  fullName  String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([approved])
  @@map("waitlist")
}

model AgentWorkingMemory {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  agentId   String   @unique(map: "agent_working_memory_agentid_key")
  sessionId String?
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("agent_working_memory")
}

model AgentShortTermMemory {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  agentId   String
  category  String
  content   String
  metadata  Json?    @default("{}")
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([agentId], map: "agent_stm_agent_idx")
  @@map("agent_short_term_memory")
}

model AgentLongTermMemory {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  agentId         String
  category        String
  pattern         String
  evidence        String[] @default([])
  confidence      Float    @default(0.5)
  occurrenceCount Int      @default(1)
  metadata        Json?    @default("{}")
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([agentId], map: "agent_ltm_agent_idx")
  @@map("agent_long_term_memory")
}

model AgentEpisodicMemory {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  agentId     String
  eventType   String
  title       String
  description String?
  impact      String?
  tags        String[] @default([])
  metadata    Json?    @default("{}")
  occurredAt  DateTime @default(now()) @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([agentId], map: "agent_em_agent_idx")
  @@map("agent_episodic_memory")
}

model ad_performance {
  id            Int       @id @default(autoincrement())
  platform      String
  campaign_name String    @default("")
  ad_set        String?   @default("")
  spend         Decimal?  @default(0) @db.Decimal
  impressions   Int?      @default(0)
  clicks        Int?      @default(0)
  conversions   Int?      @default(0)
  ctr           Decimal?  @default(0) @db.Decimal
  cpc           Decimal?  @default(0) @db.Decimal
  cpa           Decimal?  @default(0) @db.Decimal
  roas          Decimal?  @default(0) @db.Decimal
  date          DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  metadata      Json?     @default("{}")
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
}

model audit_log {
  id                 Int       @id @default(autoincrement())
  agent_id           String
  action_type        String
  action_description String?   @default("")
  entity_type        String?   @default("")
  entity_id          String?   @default("")
  risk_score         Int?      @default(1)
  cost_amount        Decimal?  @default(0) @db.Decimal
  cost_currency      String?   @default("USD")
  input_summary      String?   @default("")
  output_summary     String?   @default("")
  status             String?   @default("success")
  metadata           Json?     @default("{}")
  created_at         DateTime? @default(now()) @db.Timestamptz(6)

  @@index([action_type], map: "idx_audit_log_action")
  @@index([agent_id], map: "idx_audit_log_agent")
}

model content_calendar {
  id                     Int                      @id @default(autoincrement())
  agent_id               String
  platform               String
  content_type           String
  title                  String                   @default("")
  body                   String                   @default("")
  media_urls             String[]                 @default([])
  media_hints            String?                  @default("")
  content_pillar         String?                  @default("")
  hook                   String?                  @default("")
  cta                    String?                  @default("")
  target_audience        String?                  @default("")
  funnel_stage           String?                  @default("")
  scheduled_time         DateTime?                @db.Timestamptz(6)
  published_at           DateTime?                @db.Timestamptz(6)
  risk_score             Int?                     @default(1)
  risk_factors           Json?                    @default("[]")
  status                 String?                  @default("draft")
  approval_notes         String?
  publish_result         Json?                    @default("{}")
  metadata               Json?                    @default("{}")
