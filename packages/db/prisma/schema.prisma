// ============================================
// Boardy AI — Database Schema
// PostgreSQL + pgvector
// ============================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?  @unique
  passwordHash  String
  role          Role     @default(USER)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       Profile?
  conversations Conversation[]
  sentMatches   Match[]        @relation("MatchUserA")
  receivedMatches Match[]      @relation("MatchUserB")
  calls         Call[]
  notifications Notification[]
  embeddings    UserEmbedding[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

enum Role {
  USER
  ADMIN
}

// ─────────────────────────────────────────────
// PROFILES
// ─────────────────────────────────────────────

model Profile {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Core fields
  persona          PersonaType?
  headline         String?
  bio              String?
  companyName      String?
  companyStage     CompanyStage?
  currentRole      String?
  location         String?
  linkedinUrl      String?
  websiteUrl       String?
  yearsExperience  Int?

  // Array fields
  industries       String[]     @default([])
  skills           String[]     @default([])
  interests        String[]     @default([])
  lookingFor       String[]     @default([])

  // Polymorphic extension data (persona-specific fields)
  extraData        Json?        @db.JsonB

  // Computed
  completenessScore Float       @default(0)
  isComplete       Boolean      @default(false)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([persona])
  @@index([companyStage])
  @@index([location])
  @@index([completenessScore])
  @@map("profiles")
}

enum PersonaType {
  FOUNDER
  INVESTOR
  ADVISOR
  OPERATOR
  JOB_SEEKER
  RECRUITER
  FREELANCER
  OTHER
}

enum CompanyStage {
  PRE_SEED
  SEED
  SERIES_A
  SERIES_B
  SERIES_C_PLUS
  GROWTH
  PUBLIC
  BOOTSTRAPPED
}

// ─────────────────────────────────────────────
// CONVERSATIONS
// ─────────────────────────────────────────────

model Conversation {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  flowId      String
  status      ConversationStatus @default(ACTIVE)
  currentNode String?
  context     Json?              @db.JsonB  // Accumulated answers
  startedAt   DateTime           @default(now())
  completedAt DateTime?

  messages    Message[]

  @@index([userId])
  @@index([status])
  @@map("conversations")
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  PAUSED
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  content        String
  nodeId         String?
  metadata       Json?        @db.JsonB
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

enum MessageSender {
  USER
  AI
  SYSTEM
}

// ─────────────────────────────────────────────
// MATCHES
// ─────────────────────────────────────────────

model Match {
  id          String      @id @default(cuid())
  userAId     String
  userBId     String
  userA       User        @relation("MatchUserA", fields: [userAId], references: [id])
  userB       User        @relation("MatchUserB", fields: [userBId], references: [id])

  status      MatchStatus @default(PROPOSED)
  score       Float
  scoreBreakdown Json?    @db.JsonB

  // Double opt-in tracking
  userAResponse MatchResponse?
  userBResponse MatchResponse?
  userARespondedAt DateTime?
  userBRespondedAt DateTime?

  reason      String?     // AI-generated reason for match
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  expiresAt   DateTime?

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@index([status])
  @@index([score])
  @@map("matches")
}

enum MatchStatus {
  PROPOSED
  PENDING_A
  PENDING_B
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MatchResponse {
  ACCEPTED
  REJECTED
  PENDING
}

// ─────────────────────────────────────────────
// CALLS (Voice AI)
// ─────────────────────────────────────────────

model Call {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  twilioCallSid String?    @unique
  status        CallStatus @default(SCHEDULED)
  direction     CallDirection @default(OUTBOUND)
  phoneNumber   String
  duration      Int?       // seconds
  transcript    Json?      @db.JsonB
  extractedData Json?      @db.JsonB
  scheduledAt   DateTime?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime   @default(now())

  @@index([userId])
  @@index([status])
  @@index([twilioCallSid])
  @@map("calls")
}

enum CallStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

// ─────────────────────────────────────────────
// EMBEDDINGS (pgvector)
// ─────────────────────────────────────────────

model UserEmbedding {
  id        String                       @id @default(cuid())
  userId    String
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vector    Unsupported("vector(1536)")
  source    EmbeddingSource
  content   String                       // The text that was embedded
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@index([userId])
  @@map("user_embeddings")
}

enum EmbeddingSource {
  PROFILE
  CONVERSATION
  CALL_TRANSCRIPT
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  event     NotificationEvent
  title     String
  body      String
  metadata  Json?               @db.JsonB
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId])
  @@index([event])
  @@index([sentAt])
  @@map("notifications")
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
  IN_APP
}

enum NotificationEvent {
  MATCH_FOUND
  INTRO_REQUEST
  INTRO_ACCEPTED
  INTRO_REJECTED
  PROFILE_COMPLETE
  CALL_SCHEDULED
  CALL_REMINDER
}
