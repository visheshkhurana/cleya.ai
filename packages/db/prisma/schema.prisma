// ============================================
// Cleya.ai — Database Schema
// PostgreSQL + pgvector
// ============================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?  @unique
  name          String?
  passwordHash  String
  role          Role     @default(USER)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       Profile?
  conversations Conversation[]
  sentMatches   Match[]        @relation("MatchUserA")
  receivedMatches Match[]      @relation("MatchUserB")
  calls         Call[]
  notifications Notification[]
  embeddings    UserEmbedding[]
  messageRecords MessageRecord[]
  scoutedDeals    DealTracking[] @relation("DealPartnerDeals")
  foundedDeals    DealTracking[] @relation("FounderDeals")
  organizedEvents Event[]
  eventParticipations EventParticipant[]
  matchFeedbacks MatchFeedback[]
  introductionsAsA IntroductionRecord[] @relation("IntroUserA")
  introductionsAsB IntroductionRecord[] @relation("IntroUserB")
  communicationPreference CommunicationPreference?

  onboardingComplete Boolean @default(false)

  utmSource    String?
  utmMedium    String?
  utmCampaign  String?

  inviteCodesCreated InviteCode[] @relation("InviteCodeCreator")
  inviteCodeUsed     InviteCode?  @relation("InviteCodeUser")
  activities         Activity[]

  sentDirectMessages     DirectMessage[] @relation("DirectMessageSender")
  receivedDirectMessages DirectMessage[] @relation("DirectMessageRecipient")
  organizedMeetings      Meeting[]       @relation("MeetingOrganizer")
  participantMeetings    Meeting[]       @relation("MeetingParticipant")

  secretaryThreads       SecretaryMessage[]

  zoomAccessToken        String?
  zoomRefreshToken       String?
  zoomUserId             String?

  @@index([email])
  @@index([phone])
  @@map("users")
}

enum Role {
  USER
  ADMIN
}

// ─────────────────────────────────────────────
// PROFILES
// ─────────────────────────────────────────────

model Profile {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Core fields
  persona          PersonaType?
  headline         String?
  bio              String?
  avatarUrl        String?
  companyName      String?
  companyStage     CompanyStage?
  currentRole      String?
  location         String?
  linkedinUrl      String?
  websiteUrl       String?
  phoneNumber      String?
  yearsExperience  Int?

  // Array fields
  industries       String[]     @default([])
  skills           String[]     @default([])
  interests        String[]     @default([])
  lookingFor       String[]     @default([])

  // Founder-specific fields
  priority         FounderPriority?
  raiseAmount      String?
  roundCloseDate   String?
  amountRaisedToDate String?
  businessDescription String?
  keyTractionPoints String?

  // Investor-specific fields
  investorType     String?
  investmentAmount String?
  accreditedInvestor Boolean?

  // Talent-specific fields
  targetRole       TalentTargetRole?

  // Venture Partner / Deal Partner fields
  fundName         String?
  fundSize         String?
  investmentRange  String?
  industryFocus    String[]     @default([])
  investmentThesis String?

  // Scout / Deal Partner fields
  cityBased        String?
  exampleInvestment String?
  outreachMethod   String?
  trackedCompanies String?
  founderAccessPitch String?

  // Attribution tracking
  channelSource    String?
  channelType      String?

  // Polymorphic extension data (any additional persona-specific fields)
  extraData        Json?        @db.JsonB

  // AI matching — pgvector embedding
  profileEmbedding Unsupported("vector(1536)")?

  // Verification
  linkedinVerified   Boolean    @default(false)
  verificationScore  Float      @default(0)

  // Computed
  completenessScore Float       @default(0)
  isComplete       Boolean      @default(false)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([persona])
  @@index([companyStage])
  @@index([location])
  @@index([completenessScore])
  @@map("profiles")
}

enum PersonaType {
  FOUNDER
  INVESTOR
  TALENT
  DEAL_PARTNER
  VENTURE_PARTNER
  EVENT_PARTICIPANT
  ADVISOR
  OPERATOR
  JOB_SEEKER
  RECRUITER
  FREELANCER
  OTHER
}

enum FounderPriority {
  FUNDRAISING
  COFOUNDER
  HIRING
  MARKETING
  SALES_BD
  VENTURE_PARTNER_HIRE
}

enum TalentTargetRole {
  FOUNDING_ENGINEER
  FOUNDING_GTM
  CHIEF_OF_STAFF
  GROWTH_CONTENT
  OPEN_APPLICATION
  COFOUNDER
}

enum CompanyStage {
  PRE_SEED
  SEED
  SERIES_A
  SERIES_B
  SERIES_C_PLUS
  GROWTH
  PUBLIC
  BOOTSTRAPPED
}

// ─────────────────────────────────────────────
// CONVERSATIONS
// ─────────────────────────────────────────────

model Conversation {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  flowId      String
  status      ConversationStatus @default(ACTIVE)
  currentNode String?
  context     Json?              @db.JsonB
  startedAt   DateTime           @default(now())
  completedAt DateTime?

  messages    Message[]

  @@index([userId])
  @@index([status])
  @@map("conversations")
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  PAUSED
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  content        String
  nodeId         String?
  metadata       Json?        @db.JsonB
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

enum MessageSender {
  USER
  AI
  SYSTEM
}

// ─────────────────────────────────────────────
// MATCHES
// ─────────────────────────────────────────────

model Match {
  id          String      @id @default(cuid())
  userAId     String
  userBId     String
  userA       User        @relation("MatchUserA", fields: [userAId], references: [id])
  userB       User        @relation("MatchUserB", fields: [userBId], references: [id])

  status      MatchStatus @default(PROPOSED)
  score       Float
  scoreBreakdown Json?    @db.JsonB

  userAResponse MatchResponse?
  userBResponse MatchResponse?
  userARespondedAt DateTime?
  userBRespondedAt DateTime?

  reason      String?
  eventId     String?
  event       Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  expiresAt   DateTime?

  feedbacks   MatchFeedback[]
  introduction IntroductionRecord?

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@index([status])
  @@index([score])
  @@index([eventId])
  @@map("matches")
}

model MatchFeedback {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  feedback  String?
  createdAt DateTime @default(now())

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
  @@map("match_feedbacks")
}

enum MatchStatus {
  PROPOSED
  PENDING_A
  PENDING_B
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MatchResponse {
  ACCEPTED
  REJECTED
  PENDING
}

// ─────────────────────────────────────────────
// INTRODUCTIONS
// ─────────────────────────────────────────────

model IntroductionRecord {
  id           String             @id @default(cuid())
  matchId      String             @unique
  match        Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userAId      String
  userA        User               @relation("IntroUserA", fields: [userAId], references: [id])
  userBId      String
  userB        User               @relation("IntroUserB", fields: [userBId], references: [id])
  status       IntroductionStatus @default(SENT)
  introText    String?
  talkingPoints String[]          @default([])
  sentVia      String?
  sentAt       DateTime?
  followUpAt   DateTime?
  outcome      String?
  outcomeNotes String?
  scheduledAt  DateTime?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userAId])
  @@index([userBId])
  @@index([status])
  @@map("introduction_records")
}

enum IntroductionStatus {
  PENDING_APPROVAL
  APPROVED
  SENT
  VIEWED
  RESPONDED
  MEETING_SCHEDULED
  FOLLOWED_UP
  COMPLETED
  CANCELLED
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("activities")
}

// ─────────────────────────────────────────────
// CALLS (Voice AI)
// ─────────────────────────────────────────────

model Call {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  twilioCallSid String?    @unique
  status        CallStatus @default(SCHEDULED)
  direction     CallDirection @default(OUTBOUND)
  phoneNumber   String
  duration      Int?
  transcript    Json?      @db.JsonB
  extractedData Json?      @db.JsonB
  scheduledAt   DateTime?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime   @default(now())

  @@index([userId])
  @@index([status])
  @@index([twilioCallSid])
  @@map("calls")
}

enum CallStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

// ─────────────────────────────────────────────
// EMBEDDINGS (pgvector)
// ─────────────────────────────────────────────

model UserEmbedding {
  id        String                       @id @default(cuid())
  userId    String
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vector    Unsupported("vector(1536)")
  source    EmbeddingSource
  content   String
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@index([userId])
  @@map("user_embeddings")
}

enum EmbeddingSource {
  PROFILE
  CONVERSATION
  CALL_TRANSCRIPT
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  event     NotificationEvent
  title     String
  body      String
  metadata  Json?               @db.JsonB
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId])
  @@index([event])
  @@index([sentAt])
  @@map("notifications")
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
  IN_APP
}

enum NotificationEvent {
  MATCH_FOUND
  INTRO_REQUEST
  INTRO_PENDING
  INTRO_ACCEPTED
  INTRO_REJECTED
  PROFILE_COMPLETE
  CALL_SCHEDULED
  CALL_REMINDER
  MEETING_PROPOSED
  MEETING_CONFIRMED
  SECRETARY_DIGEST
}

// ─────────────────────────────────────────────
// MESSAGE RECORDS (SMS, WhatsApp, Email)
// ─────────────────────────────────────────────

model MessageRecord {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientPhone  String
  channel         MessageChannel
  content         String
  status          MessageStatus    @default(QUEUED)
  messageSid      String?
  errorMessage    String?
  provider        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
  @@map("message_records")
}

enum MessageChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

// ─────────────────────────────────────────────
// DEAL TRACKING (Scout / Deal Partner flow)
// ─────────────────────────────────────────────

model DealTracking {
  id              String          @id @default(cuid())
  dealPartnerId   String
  dealPartner     User            @relation("DealPartnerDeals", fields: [dealPartnerId], references: [id], onDelete: Cascade)
  founderId       String
  founder         User            @relation("FounderDeals", fields: [founderId], references: [id], onDelete: Cascade)

  status          DealStatus      @default(OPEN)
  industry        String?
  stage           CompanyStage?
  notes           String?
  dealValue       Float?
  carryPercentage Float?
  introSent       Boolean         @default(false)
  introSentAt     DateTime?
  introDate       DateTime?
  closeDate       DateTime?
  responseStatus  DealResponse?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([dealPartnerId, founderId])
  @@index([dealPartnerId])
  @@index([founderId])
  @@index([status])
  @@map("deal_tracking")
}

enum DealStatus {
  OPEN
  INTRO_MADE
  CLOSED_WON
  CLOSED_LOST
}

enum DealResponse {
  PENDING
  INTERESTED
  NOT_INTERESTED
  MEETING_SCHEDULED
}

// ─────────────────────────────────────────────
// EVENTS
// ─────────────────────────────────────────────

model Event {
  id           String             @id @default(cuid())
  name         String
  description  String?
  date         DateTime
  endDate      DateTime?
  location     String?
  isVirtual    Boolean            @default(false)
  maxCapacity  Int?
  organizerId  String
  organizer    User               @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  status       EventStatus        @default(UPCOMING)
  metadata     Json?              @db.JsonB

  participants EventParticipant[]
  matches      Match[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([organizerId])
  @@index([date])
  @@index([status])
  @@map("events")
}

enum EventStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

model EventParticipant {
  id               String                  @id @default(cuid())
  eventId          String
  event            Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           EventParticipantStatus  @default(REGISTERED)
  checkedIn        Boolean                 @default(false)
  notes            String?
  eventCode        String?
  eventName        String?
  pitchTopic       String?
  preferredMentors String[]                @default([])
  registeredAt     DateTime                @default(now())

  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_participants")
}

enum EventParticipantStatus {
  REGISTERED
  CONFIRMED
  WAITLISTED
  CANCELLED
  ATTENDED
}

// ─────────────────────────────────────────────
// COMMUNICATION PREFERENCES
// ─────────────────────────────────────────────

model CommunicationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailEnabled    Boolean  @default(true)
  smsEnabled      Boolean  @default(false)
  whatsappEnabled Boolean  @default(false)
  inAppEnabled    Boolean  @default(true)

  matchNotify     Boolean  @default(true)
  introNotify     Boolean  @default(true)
  weeklyDigest    Boolean  @default(true)
  marketingEmails Boolean  @default(false)

  whatsappMatchNotify  Boolean @default(true)
  whatsappIntroNotify  Boolean @default(true)
  whatsappWeeklyDigest Boolean @default(true)

  quietHoursStart String?
  quietHoursEnd   String?
  timezone        String?  @default("Asia/Kolkata")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("communication_preferences")
}

// ─────────────────────────────────────────────
// INVITE CODES
// ─────────────────────────────────────────────

model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  createdById String
  createdBy   User      @relation("InviteCodeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedById    String?   @unique
  usedBy      User?     @relation("InviteCodeUser", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([code])
  @@index([createdById])
  @@map("invite_codes")
}

// ─────────────────────────────────────────────
// DIRECT MESSAGES (P2P chat between matched users)
// ─────────────────────────────────────────────

model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("DirectMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  matchId     String?
  content     String
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@index([matchId])
  @@index([createdAt])
  @@map("direct_messages")
}

// ─────────────────────────────────────────────
// MEETINGS (scheduling between matched users)
// ─────────────────────────────────────────────

model Meeting {
  id            String        @id @default(cuid())
  organizerId   String
  organizer     User          @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  participantId String
  participant   User          @relation("MeetingParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  matchId       String?
  title         String
  description   String?
  proposedTimes DateTime[]
  confirmedTime DateTime?
  duration      Int           @default(30)
  location      String?
  meetingUrl    String?
  zoomMeetingId String?
  status        MeetingStatus @default(PROPOSED)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([organizerId])
  @@index([participantId])
  @@index([status])
  @@map("meetings")
}

enum MeetingStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

// ─────────────────────────────────────────────
// AI SECRETARY (per-user conversation history)
// ─────────────────────────────────────────────

model SecretaryMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MessageSender
  content   String
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("secretary_messages")
}

// ─────────────────────────────────────────────
// WAITLIST
// ─────────────────────────────────────────────

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  persona   String?
  fullName  String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([approved])
  @@map("waitlist")
}
